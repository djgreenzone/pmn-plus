      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/terms-of-service/",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/store/:path*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/merch",
      "destination": "/shop",
