{
  "trailingSlash": false,
  "headers": [
    { "source": "/shop/app-(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/shop/:dir(hires|frames|brand|og)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/assets/:dir(home|about|ig|email)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/assets/:file(.*\\.(?:png|jpg|jpeg|webp|avif|svg|mp4))", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/assets/:file(pmn-nav\\.css|pmn-nav\\.js|pmn-config\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "polynesianmusicnetwork.com" }], "destination": "https://www.polynesianmusicnetwork.com/:path*", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/about-us/", "destination": "/about", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/contact-us/", "destination": "/contact", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": true },
    { "source": "/terms-of-service/", "destination": "/terms", "permanent": true },
    { "source": "/store", "destination": "/shop", "permanent": true },
    { "source": "/store/:path*", "destination": "/shop", "permanent": true },
    { "source": "/merch", "destination": "/shop", "permanent": true },
    { "source": "/merch/:path*", "destination": "/shop", "permanent": true }
  ]
}
